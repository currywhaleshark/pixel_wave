{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixel-wave.local/schema/terrain-overrides.v1.json",
  "title": "Pixel Wave Terrain Profile Overrides v1",
  "description": "Human review decisions kept separate from regenerated terrain profile data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "profileId",
    "assetSha256",
    "surfacePatches",
    "excludeRanges",
    "approvedSocketIds",
    "excludedSocketIds",
    "forcedSockets"
  ],
  "properties": {
    "format": { "const": "pixel-wave-terrain-overrides" },
    "schemaVersion": { "const": 1 },
    "profileId": { "$ref": "#/$defs/id" },
    "assetSha256": { "$ref": "#/$defs/sha256" },
    "surfacePatches": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/surfacePatch" }
    },
    "excludeRanges": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/excludeRange" }
    },
    "approvedSocketIds": { "$ref": "#/$defs/idList" },
    "excludedSocketIds": { "$ref": "#/$defs/idList" },
    "forcedSockets": {
      "type": "array",
      "maxItems": 2048,
      "items": { "$ref": "#/$defs/forcedSocket" }
    },
    "notes": { "type": "string", "maxLength": 2000 }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 100
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "idList": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "surfaceSample": {
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 8191 },
        { "type": "null" }
      ]
    },
    "surfacePatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "startX", "samples", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "surface": { "enum": ["floor", "ceiling"] },
        "startX": { "type": "integer", "minimum": 0, "maximum": 16383 },
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16384,
          "items": { "$ref": "#/$defs/surfaceSample" }
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "excludeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "startX", "endX", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "surface": { "enum": ["floor", "ceiling"] },
        "classId": { "$ref": "#/$defs/id" },
        "startX": { "type": "integer", "minimum": 0, "maximum": 16383 },
        "endX": { "type": "integer", "minimum": 0, "maximum": 16383 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "normal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": -1, "maximum": 1 },
        "y": { "type": "number", "minimum": -1, "maximum": 1 }
      }
    },
    "forcedSocket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "classId", "surface", "x", "y", "normal", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "classId": { "$ref": "#/$defs/id" },
        "surface": { "enum": ["floor", "ceiling"] },
        "x": { "type": "integer", "minimum": 0, "maximum": 16383 },
        "y": { "type": "integer", "minimum": 0, "maximum": 8191 },
        "normal": { "$ref": "#/$defs/normal" },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
